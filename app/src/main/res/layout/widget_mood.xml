<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@android:color/white"
    tools:ignore="Overdraw,ButtonStyle">

    <Button
        android:id="@+id/mood_button_very_sad"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:textSize="24sp"
        android:text="@string/mood_emoji_very_sad"
        android:contentDescription="@string/mood_description_very_sad" />

    <Button
        android:id="@+id/mood_button_sad"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:textSize="24sp"
        android:text="@string/mood_emoji_sad"
        android:contentDescription="@string/mood_description_sad" />

    <Button
        android:id="@+id/mood_button_neutral"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:textSize="24sp"
        android:text="@string/mood_emoji_neutral"
        android:contentDescription="@string/mood_description_neutral" />

    <Button
        android:id="@+id/mood_button_happy"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:textSize="24sp"
        android:text="@string/mood_emoji_happy"
        android:contentDescription="@string/mood_description_happy" />

    <Button
        android:id="@+id/mood_button_very_happy"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:textSize="24sp"
        android:text="@string/mood_emoji_very_happy"
        android:contentDescription="@string/mood_description_very_happy" />

</LinearLayout>
